{
	"Name": "JHON_LEMON",
	"CameraPosition":[-9.8,5.6,-8.8],
	"CameraRotation":[45,0.0,0.0],
	"SunPosition":[0.0,3.0,0.0],
	"SunRotation":[30.0,20.0,0.0],
	"SunColor":[225,240,250],
	"SunAmbientColor":[170,180,200],
	"Cast": [{
			"Name":"House",
			"Prefab":"Level"
		},{
			"Name":"End",
			"Prefab":"GameEnding",
			"Tag":"End",
			"Position":[18.0,1.0,1.5]
		},{
			"Name":"Won",
			"Prefab":"Won",
			"Active": false,
			"Properties":["counter=0"],
			"Script":[{
				"When":["Compare(this.counter>=100)"],
				"Do":["QuitGame()"]
				},{
				"When":["Compare(this.counter<=100)"],
				"Do":["this.counter=this.counter+1"]
				}
			]
		},{
			"Name":"Caught",
			"Prefab":"Caught",
			"Active": false,
			"Properties":["counter=0"],
			"Script":[{
				"When":["Compare(this.counter>=100)"],
				"Do":["LoadScene()"]
				},{
				"When":["Compare(this.counter<100)"],
				"Do":["this.counter=this.counter+1"]
				}
			]
		},{
			"Name":"John",
			"Prefab":"JohnLemon",
			"Position":[-9.8,0.0,-3.2],
			"Properties":["move=0","speed=1","desp=5.6"],
			"Script": [{
				"Do":["this.move=0","Camera.x=this.x","Camera.z=this.z-this.desp","Animate(0)"]
				},{
				"When":["Keyboard(RightArrow,press)"],
				"Do":["Move(90,this.speed)","this.ry=90","Animate(1)","this.move=1"]
				},{
				"When":["Keyboard(LeftArrow,press)"],
				"Do":["Move(-90,this.speed)","this.ry=-90","Animate(1)","this.move=1"]
				},{
				"When":["Keyboard(UpArrow,press)"],
				"Do":["Move(0,this.speed)","this.ry=0","Animate(1)","this.move=1"]
				},{
				"When":["Keyboard(DownArrow,press)"],
				"Do":["Move(180,this.speed)","this.ry=180","Animate(1)","this.move=1"]
				},{
				"When":["Collision(Enemy)"],
				"Do":["Caught.Active=1"]
				},{
				"When":["Collision(End)"],
				"Do":["Won.Active=1"]
				},{
				"When":["Compare(this.move==0)"],
				"Do":["StopSound(Footsteps)"]
				},{
				"When":["Compare(this.move==1)"],
				"Do":["PlaySound(Footsteps)"]
				}
			]
		},{
			"Name":"Gargoyle1",
			"Prefab":"Gargoyle",
			"Tag": "Enemy",
			"Position":[-2.6,0.0,-8.5],
			"Rotation":[0.0,30.0,0.0]
		},{
			"Name":"Gargoyle2",
			"Prefab":"Gargoyle",
			"Tag": "Enemy",
			"Position":[1.5,0.0,10.65],
			"Rotation":[0.0,218.0,0.0]
		},{
			"Name":"Ghost1",
			"Prefab":"Ghost",
			"Tag": "Enemy",
			"Position":[-5.5,0.0,-4.5],
			"Properties":["speed=1.0","zObj=6.4","z0=-4.5","z1=6.4"],
			"Script":[{
				"Do":["NavigateTo(this.x,this.zObj,this.speed)"]
				},{
				"When":["Compare(this.z>=this.z1)"],
				"Do":["this.zObj=this.z0"]
				},{
				"When":["Compare(this.z<=this.z0)"],
				"Do":["this.zObj=this.z1"]
				}
			]
		},{
			"Name":"Ghost2",
			"Prefab":"Ghost",
			"Tag": "Enemy",
			"Position":[0.9,0.0,-3.5],
			"Properties":["speed=1.0","zObj=7.6","z0=-3.5","z1=7.6"],
			"Script":[{
				"Do":["NavigateTo(this.x,this.zObj,this.speed)"]
				},{
				"When":["Compare(this.z>=this.z1)"],
				"Do":["this.zObj=this.z0"]
				},{
				"When":["Compare(this.z<=this.z0)"],
				"Do":["this.zObj=this.z1"]
				}
			]
		},{
			"Name":"Ghost3",
			"Prefab":"Ghost",
			"Tag": "Enemy",
			"Position":[3.3,0.0,5.8],
			"Properties":["delta=0.5","speed=1.0","xObj=3.2","zObj=12.3","x0=3.2","x1=6.5","z0=5.7","z1=12.3"],
			"Script":[{
				"Do":["NavigateTo(this.xObj,this.zObj,this.speed)"]
				},{
				"When":["(abs(this.z-this.z1)<this.delta) && (abs(this.x-this.x0)<this.delta)"],
				"Do":["this.xObj=this.x1"]
				},{
				"When":["(abs(this.z-this.z1)<this.delta) && (abs(this.x-this.x1)<this.delta)"],
				"Do":["this.zObj=this.z0"]
				},{
				"When":["(abs(this.z-this.z0)<this.delta) && (abs(this.x-this.x1)<this.delta)"],
				"Do":["this.xObj=this.x0"]
				},{
				"When":["(abs(this.z-this.z0)<this.delta) && (abs(this.x-this.x0)<this.delta)"],
				"Do":["this.zObj=this.z1"]
				}
			]
		},{
			"Name":"Ghost4",
			"Prefab":"Ghost",
			"Tag": "Enemy",
			"Position":[3.2,0.0,-5.0],
			"Properties":["delta=0.5","speed=1.0","xObj=7.4","zObj=-2.0","x0=3.2","x1=7.4","z0=-5","z1=-2"],
			"Script":[{
				"Do":["NavigateTo(this.xObj,this.zObj,this.speed)"]
				},{
				"When":["(abs(this.z-this.z0)<this.delta) && (abs(this.x-this.x0)<this.delta)"],
				"Do":["this.xObj=this.x1","this.zObj=this.z1"]
				},{
				"When":["(abs(this.z-this.z1)<this.delta) && (abs(this.x-this.x1)<this.delta)"],
				"Do":["this.xObj=this.x0","this.zObj=this.z0"]
				}
			]
		}
	]
}