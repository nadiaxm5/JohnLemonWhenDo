{
	"Name": "JHON_LEMON",
	"CameraPosition":[-9.8,5.6,-8.8],
	"CameraRotation":[45,0.0,0.0],
	"SunPosition":[0.0,3.0,0.0],
	"SunRotation":[30.0,20.0,0.0],
	"SunColor":[225,240,250],
	"SunAmbientColor":[170,180,200],
	"Cast": [{
			"Name":"House",
			"Prefab":"Level"
		},{
			"Name":"End",
			"Prefab":"GameEnding",
			"Tag":"End",
			"Position":[18.0,1.0,1.5]
		},{
			"Name":"Won",
			"Prefab":"Won",
			"Active": false,
			"Properties":["counter=0"],
			"Script":[{
				"When":["Compare(this.counter>=100)"],
				"Do":["QuitGame()"]
				},{
				"When":["Compare(this.counter<=100)"],
				"Do":["Edit(this.counter,this.counter+1)"]
				}
			]
		},{
			"Name":"Caught",
			"Prefab":"Caught",
			"Active": false,
			"Properties":["counter=0"],
			"Script":[{
				"When":["Compare(this.counter>=100)"],
				"Do":["LoadScene()"]
				},{
				"When":["Compare(this.counter<100)"],
				"Do":["Edit(this.counter,this.counter+1)"]
				}
			]
		},{
			"Name":"John",
			"Prefab":"JohnLemon",
			"Position":[-9.8,0.0,-3.2],
			"Properties":["speed=1","desp=5.6","moving=0"],
			"Script": [{
				"Do":["Edit(Camera.x,this.x)","Edit(Camera.z,this.z-this.desp)"]
				},{
				"When":["Keyboard(RightArrow,press)"],
				"Do":["Move(this.speed,0,90,0)","Edit(this.ry,90)","Edit(this.moving,1)"]
				},{
				"When":["Keyboard(LeftArrow,press)"],
				"Do":["Move(this.speed,0,-90,0)","Edit(this.ry,-90)","Edit(this.moving,1)"]
				},{
				"When":["Keyboard(UpArrow,press)"],
				"Do":["Move(this.speed,0,0,0)","Edit(this.ry,0)","Edit(this.moving,1)"]
				},{
				"When":["Keyboard(DownArrow,press)"],
				"Do":["Move(this.speed,0,180,0)","Edit(this.ry,180)","Edit(this.moving,1)"]
				},{
				"When":["Keyboard(RightArrow,up)"],
				"Do":["Edit(this.moving,0)"]
				},{
				"When":["Keyboard(LeftArrow,up)"],
				"Do":["Edit(this.moving,0)"]
				},{
				"When":["Keyboard(UpArrow,up)"],
				"Do":["Edit(this.moving,0)"]
				},{
				"When":["Keyboard(DownArrow,up)"],
				"Do":["Edit(this.moving,0)"]
				},{
				"When":["Collision(Enemy)"],
				"Do":["Edit(Caught.Active,1)"]
				},{
				"When":["Collision(End)"],
				"Do":["Edit(Won.Active,1)"]
				},{
				"When":["Compare(this.moving==0)"],
				"Do":["Animate(John_Idle)"]
				},{
				"When":["Compare(this.moving==1)"],
				"Do":["Animate(John_Walk)","PlaySound(Footsteps)"]
				}
			]
		},{
			"Name":"Gargoyle1",
			"Prefab":"Gargoyle",
			"Tag": "Enemy",
			"Position":[-2.6,0.0,-8.5],
			"Rotation":[0.0,30.0,0.0]
		},{
			"Name":"Gargoyle2",
			"Prefab":"Gargoyle",
			"Tag": "Enemy",
			"Position":[1.5,0.0,10.65],
			"Rotation":[0.0,218.0,0.0]
		},{
			"Name":"Ghost1",
