			"Script":[{
				"Do":["NavigateTo(this.speed,this.x,this.y,this.zObj)"]
				},{
				"When":["Compare(this.z>=this.z1)"],
				"Do":["Edit(this.zObj,this.z0)"]
				},{
				"When":["Compare(this.z<=this.z0)"],
				"Do":["Edit(this.zObj,this.z1)"]
