			"Script":[{
				"Do":["NavigateTo(this.speed,this.xObj,this.y,this.zObj)"]
				},{
				"When":["Compare((abs(this.z-this.z1)<this.delta) && (abs(this.x-this.x0)<this.delta))"],
				"Do":["Edit(this.xObj,this.x1)"]
				},{
				"When":["Compare((abs(this.z-this.z1)<this.delta) && (abs(this.x-this.x1)<this.delta))"],
				"Do":["Edit(this.zObj,this.z0)"]
				},{
				"When":["Compare((abs(this.z-this.z0)<this.delta) && (abs(this.x-this.x1)<this.delta))"],
				"Do":["Edit(this.xObj,this.x0)"]
				},{
				"When":["Compare((abs(this.z-this.z0)<this.delta) && (abs(this.x-this.x0)<this.delta))"],
				"Do":["Edit(this.zObj,this.z1)"]
				}
			]
		},{
